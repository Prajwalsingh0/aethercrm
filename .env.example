# AetherCRM environment example - copy to .env and fill values
# NEVER commit real secrets

JWT_SECRET=change-me-in-production-use-at-least-256-bits-secret-key-here!!
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Optional PostgreSQL (default is H2 file DB)
# DATABASE_URL=jdbc:postgresql://localhost:5432/aethercrm
# DATABASE_USERNAME=aether
# DATABASE_PASSWORD=secret
# DATABASE_DRIVER=org.postgresql.Driver

# AI (optional - mock provider works without keys)
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_DEMO_DATA=true
